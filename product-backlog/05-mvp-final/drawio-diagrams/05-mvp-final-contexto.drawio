<mxfile host="app.diagrams.net">
  <diagram id="mvp-ctx" name="05-mvp-final C4 - Contexto">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="05-mvp-final - Integração Só Estoque ↔ Locavia Web - C4 Nível 1: Contexto" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry" /></mxCell>
        <mxCell id="lojista" value="Lojista / Operador&#10;[Pessoa]&#10;&#10;Anuncia e negocia os&#10;seminovos na Só Estoque" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;fillColor=#083F75;fontColor=#ffffff;strokeColor=#06315C;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="200" height="180" as="geometry" /></mxCell>
        <mxCell id="so" value="Plataforma Só Estoque&#10;[Sistema Externo]&#10;&#10;Vitrine de seminovos: sincroniza&#10;estoque, reserva veículos e recebe&#10;o resultado das reservas (webhook)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8a8a8a;strokeColor=#666666;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="240" height="140" as="geometry" /></mxCell>
        <mxCell id="ci" value="api-locaviaweb-car-inventory&#10;[Sistema: integração - AWS EKS]&#10;&#10;API da Só Estoque: leituras do Locavia&#10;(empresas, veículos, vendas, OS) e reservas&#10;assíncronas (SQS + DynamoDB) aplicadas&#10;no Locavia com auditoria completa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="360" width="320" height="180" as="geometry" /></mxCell>
        <mxCell id="lw" value="api-locavia-web-ts&#10;[Sistema de registro: Locavia Web]&#10;&#10;Dono das regras: /reservas-venda,&#10;/clientes (lojista), /sessoes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1040" y="230" width="300" height="140" as="geometry" /></mxCell>
        <mxCell id="sql" value="SQL Server LocaviaWeb&#10;[Banco do Locavia]&#10;&#10;ReservasVenda, Clientes, Veiculos,&#10;VendasVeiculos, OrdemServicos..." style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#2e6295;strokeColor=#1c3f5c;fontColor=#ffffff;size=12;" vertex="1" parent="1"><mxGeometry x="1060" y="520" width="260" height="150" as="geometry" /></mxCell>
        <mxCell id="usr" value="Usuário Locavia Web&#10;[Pessoa]&#10;&#10;Operação da locadora&#10;(venda, OS, frota)" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;fillColor=#083F75;fontColor=#ffffff;strokeColor=#06315C;" vertex="1" parent="1"><mxGeometry x="1100" y="20" width="200" height="180" as="geometry" /></mxCell>
        <mxCell id="aws" value="AWS&#10;[Infra gerenciada]&#10;&#10;SQS FIFO + DLQ, DynamoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8a8a8a;strokeColor=#666666;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="650" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="e1" value="Usa" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lojista" target="so"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="Consulta e reserva&#10;[HTTPS/JSON, x-api-key]" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="so" target="ci"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="Resultado das reservas&#10;[Webhook HTTPS, Bearer]" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="ci" target="so"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="600" /><mxPoint x="160" y="600" /></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="Aplica reservas e cadastra cliente&#10;[HTTPS/JSON, JWT do usuário de integração]" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ci" target="lw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="Lê (somente leitura)&#10;[TypeORM, NOLOCK]" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ci" target="sql"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="Lê e grava&#10;[TypeORM]" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lw" target="sql"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="Usa (Locavia Web)" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="usr" target="lw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="Fila e persistência&#10;[AWS SDK v3]" style="endArrow=classic;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ci" target="aws"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="leg" value="Legenda&#10;— seta contínua: chamada síncrona&#10;- - seta tracejada: assíncrona / webhook&#10;Cinza: sistema externo à Infosistemas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="300" height="80" as="geometry" /></mxCell>
      </root>
