        <mxCell id="dres" value="DynamoDB&#10;[car-inventory-reservations]&#10;&#10;Cópia da ReservasVenda&#10;(id = CodigoReserva) + history[]" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;size=12;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="250" height="150" as="geometry" /></mxCell>
