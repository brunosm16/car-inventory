<mxfile host="app.diagrams.net">
  <diagram id="mvp-cont" name="05-mvp-final C4 - Conteineres">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="05-mvp-final - C4 Nível 2: Contêineres dos três sistemas" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="so" value="Plataforma Só Estoque&#10;[Sistema Externo]&#10;&#10;Cliente da API&#10;Webhook de reservas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8a8a8a;strokeColor=#666666;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="b1" value="api-locaviaweb-car-inventory [AWS EKS - Node 22 / NestJS]" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;align=left;verticalAlign=top;fontStyle=1;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="760" height="900" as="geometry" /></mxCell>
        <mxCell id="api" value="API HTTP&#10;[Contêiner: NestJS]&#10;&#10;/car-inventory/v1&#10;POST /auth/token · GET /health&#10;GET /companies · /vehicles · /sales&#10;GET /service-orders&#10;GET|POST|PUT /reservations...&#10;Pré-validação 400/404/422" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="280" height="180" as="geometry" /></mxCell>
        <mxCell id="rcv" value="Receiver de reservas&#10;[Contêiner: mesmo processo]&#10;&#10;ProcessReservationUsecase&#10;RESERVATION_CREATE / SAVE_CUSTOMER&#10;CANCEL / WITHDRAW / NOTIFY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="380" width="290" height="180" as="geometry" /></mxCell>
        <mxCell id="sqs" value="SQS FIFO&#10;[process-reservation.fifo + DLQ]&#10;&#10;{ operationId, type }&#10;Grupo = veículo (ordem)&#10;maxReceiveCount = 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7b8fa1;strokeColor=#2e6295;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="530" y="700" width="260" height="120" as="geometry" /></mxCell>
