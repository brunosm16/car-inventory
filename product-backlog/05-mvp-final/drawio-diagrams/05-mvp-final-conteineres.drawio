        <mxCell id="sales" value="Escrita de vendas&#10;[Planejado - 03-sales]&#10;&#10;POST /sales, process-sale.fifo,&#10;car-inventory-sales&#10;(não implementado no MVP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="830" width="270" height="110" as="geometry" /></mxCell>
        <mxCell id="b2" value="Locavia Web [Infosistemas]" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;align=left;verticalAlign=top;fontStyle=1;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1130" y="70" width="520" height="900" as="geometry" /></mxCell>
