{
  "info": {
    "name": "01-reservations - api-locaviaweb-car-inventory",
    "description": "Fluxo assíncrono completo das reservas (1. Só Estoque requisita, 2. integração enfileira e responde o operationId, 3. processa e chama o Locavia, 4. audita 2xx/erro no DynamoDB — timeline da operação, 5. notifica a Só Estoque): token, reservar, consultar a operação e a auditoria, acompanhar a notificação, ler a reserva, cliente (lojista), cancelar e retirar. Rotas do contrato inicial + /withdrawal. A reserva só existe depois que o receiver aplica no Locavia (api-locavia-web-ts /reservas-venda).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "externalReference",
      "value": ""
    },
    {
      "key": "operationId",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "notificationOperationId",
      "value": ""
    },
    {
      "key": "pollTries",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "00 - Token (x-api-key)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.environment.set('carInventoryToken', pm.response.json().data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\"\n}"
        },
        "url": {
          "raw": "{{carInventoryUrl}}/car-inventory/v1/auth/token"
        }
      }
    },
    {
      "name": "01 - Fluxo: reservar, cliente e cancelar",
      "item": [
        {
          "name": "01 - Reservar veículo (POST /reservations)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('externalReference', 'SE-RES-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 com operationId', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('operationId', pm.response.json().data.operationId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{carInventoryToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalReference\": \"{{externalReference}}\",\n  \"vehicleId\": {{vehicleId}},\n  \"agreedPrice\": 73500,\n  \"customer\": {\n    \"personType\": \"INDIVIDUAL\",\n    \"document\": \"{{customerDocument}}\",\n    \"name\": \"Ana Souza\",\n    \"email\": \"ana.souza@email.com\",\n    \"phone\": \"11988887777\"\n  }\n}"
            },
            "url": {
              "raw": "{{carInventoryUrl}}/car-inventory/v1/reservations"
            }
          }
        },
        {
          "name": "02 - Status da reserva (operação + auditoria)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "const tries = Number(pm.collectionVariables.get('pollTries') || 0);",
                  "if (['PENDING', 'PROCESSING'].includes(data.status) && tries < 10) {",
                  "  pm.collectionVariables.set('pollTries', tries + 1);",
                  "  setTimeout(() => {}, 1500);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('pollTries', 0);",
                  "pm.test('operação FINISHED', () => pm.expect(data.status).to.eql('FINISHED'));",
                  "pm.collectionVariables.set('reservationId', data.result.reservationId);",
                  "pm.test('reserva criada no Locavia', () => pm.expect(data.result.locaviaSituation).to.eql('A'));",
                  "const steps = (data.timeline || []).map((e) => e.step);",
                  "pm.test('auditoria: Locavia 2xx, cópia e notificação enfileirada', () => {",
                  "  pm.expect(steps).to.include.members(['REQUESTED', 'QUEUED', 'PROCESSING', 'LOCAVIA_REQUEST', 'LOCAVIA_SUCCESS', 'COPY_UPDATED', 'SO_ESTOQUE_NOTIFICATION_QUEUED', 'FINISHED']);",
                  "  const ok = data.timeline.find((e) => e.step === 'LOCAVIA_SUCCESS');",
                  "  pm.expect(ok.detail.httpStatus).to.be.within(200, 299);",
                  "});",
                  "pm.collectionVariables.set('notificationOperationId', data.result.notificationOperationId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{carInventoryToken}}"
              }
            ],
            "url": {
              "raw": "{{carInventoryUrl}}/car-inventory/v1/reservations/operations/{{operationId}}"
            }
          }
        },
        {
          "name": "02b - Notificação à Só Estoque (passo 5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
